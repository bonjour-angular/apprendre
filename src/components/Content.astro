---
import type { Props } from "@astrojs/starlight/props";
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import CommentSection from "./CommentSection.astro";

const { slug } = Astro.props;

const sectionsWithComments = ["articles", "best-practices", "cest-quoi"];

const withCommentSection = sectionsWithComments.some((section) =>
  slug.startsWith(section)
);
---

<Default {...Astro.props}><slot /></Default>

{withCommentSection && <CommentSection />}
